# Copy to `.env`. docker compose reads this file, and so does the backend when
# run on the host (`bun run start:dev`). Inside docker compose, hostnames and
# connection URLs come from docker-compose.yml, so only the values marked
# [compose] matter there.

# --- Required -------------------------------------------------------------
# [compose] Encrypts Provider Account keys at rest (AES-256-GCM): 32 random
# bytes in base64. Generate with `openssl rand -base64 32`. Keep it safe:
# losing or changing it makes stored Provider Account keys unreadable.
ENCRYPTION_KEY=

# --- Host-run backend (ignored inside docker compose) ---------------------
DATABASE_URL=postgres://routerlm:routerlm@localhost:5432/routerlm
REDIS_URL=redis://localhost:6379
# Origin the browser opens the web app on; the backend trusts its session requests.
WEB_ORIGIN=http://localhost:3001

# --- Optional, with defaults ----------------------------------------------
# [compose] Days the worker keeps Error Captures before deleting them.
# ERROR_CAPTURE_RETENTION_DAYS=30
# Where the MiniMax M Plan quota reader asks, and how long a reading may take.
# MINIMAX_M_PLAN_QUOTA_BASE_URL=https://www.minimax.io/v1
# QUOTA_READER_TIMEOUT_MS=10000
# [compose] Host ports.
# BACKEND_PORT=3000
# WEB_PORT=3001
# DB_PORT=5432
# REDIS_PORT=6379
# [compose] Postgres credentials (only applied when the db volume is first created).
# POSTGRES_USER=routerlm
# POSTGRES_PASSWORD=routerlm
# POSTGRES_DB=routerlm
# e2e tests use their own database on the same server.
# TEST_DATABASE_URL=postgres://routerlm:routerlm@localhost:5432/routerlm_test
