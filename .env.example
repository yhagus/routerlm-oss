# Used when running the backend on the host. Inside docker compose the backend
# gets DATABASE_URL from docker-compose.yml instead.
DATABASE_URL=postgres://routerlm:routerlm@localhost:5432/routerlm
# Origin the browser opens the web app on; the backend trusts its session requests.
WEB_ORIGIN=http://localhost:3001
# Redis for the job queue (BullMQ), shared by the backend and the worker.
REDIS_URL=redis://localhost:6379
