# LobakAI v2 environment contract.
# Backend (Bun + Hono) reads BACKEND_* and the security vars below.
# Frontend build reads VITE_BACKEND_ORIGIN at `vite build` / `vite preview` time.

# --- Backend listener ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=20129

# --- Data storage ---
# Backend stores runtime state in SQLite.
DATA_DIR=~/.lobakai
BACKEND_DATABASE_PATH=~/.lobakai/db/data.sqlite

# --- One-time v1 -> v2 database import (optional, read-only input) ---
# LEGACY_DATABASE_PATH=/path/to/legacy/data.sqlite

# --- Auth / security ---
INITIAL_PASSWORD=123456
JWT_SECRET=
API_KEY_SECRET=
MACHINE_ID_SALT=
REQUIRE_LOGIN=true
REQUIRE_API_KEY=false

# --- Dashboard session cookie host (set for non-localhost deployments) ---
# BASE_URL=http://localhost:20129
# NEXT_PUBLIC_BASE_URL=http://localhost:20129

# --- Observability ---
OBSERVABILITY_ENABLED=true
# OBSERVABILITY_MAX_RECORDS=10000
# OBSERVABILITY_BATCH_SIZE=50
# OBSERVABILITY_FLUSH_INTERVAL_MS=5000
# OBSERVABILITY_MAX_JSON_SIZE=20000
# ENABLE_REQUEST_LOGS=false

# --- Optional outbound proxy for upstream provider calls ---
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# --- Optional SearXNG endpoint for the built-in unauthenticated web-search provider ---
# SEARXNG_URL=http://searxng:8080/search

# --- Frontend (Vite) build/preview ---
# Where the dashboard sends /api, /v1, /v1beta, /responses, /codex requests.
VITE_BACKEND_ORIGIN=http://127.0.0.1:20129
# Set this only when the dashboard must accept container or remote connections.
# VITE_HOST=0.0.0.0
