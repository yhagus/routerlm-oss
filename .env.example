# Used when running the backend on the host. Inside docker compose the backend
# gets DATABASE_URL from docker-compose.yml instead.
DATABASE_URL=postgres://routerlm:routerlm@localhost:5432/routerlm
# Origin the browser opens the web app on; the backend trusts its session requests.
WEB_ORIGIN=http://localhost:3001
# Redis for the job queue (BullMQ), shared by the backend and the worker.
REDIS_URL=redis://localhost:6379
# Encrypts Provider Account keys at rest (AES-256-GCM): 32 random bytes in
# base64. Generate one with `openssl rand -base64 32`. docker compose reads it
# from this file too. Keep it safe: losing it makes stored keys unreadable.
# ENCRYPTION_KEY=<paste the output of: openssl rand -base64 32>
# Days the worker keeps Error Captures (failed requests' headers and bodies)
# before deleting them. Defaults to 30.
# ERROR_CAPTURE_RETENTION_DAYS=30
