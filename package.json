{
  "name": "routerlm-nest",
  "version": "6.2.0",
  "private": true,
  "description": "",
  "license": "Apache-2.0",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "oxfmt src tests scripts",
    "format:check": "oxfmt --check src tests scripts",
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:debug": "bun --inspect --watch src/main.ts",
    "start:prod": "bun dist/main.js",
    "worker": "bun run src/worker.ts",
    "worker:dev": "bun --watch src/worker.ts",
    "worker:prod": "bun dist/worker.js",
    "migrate:prod": "bun dist/migrate.js",
    "lint": "oxlint --type-aware src/ tests/ scripts/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:mirrors": "bun scripts/check-web-mirrors.ts",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run check:mirrors && bun run check:redis-keys",
    "check:redis-keys": "! grep -rnE --include='*.ts' '[\"`]routerlm:[a-z]' tests --exclude-dir=support || (echo 'check:redis-keys: a test spells a Redis key; use the helpers in tests/support/redis-state.ts' && false)",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:docker": "bun scripts/test-docker.ts",
    "perf:k6": "sh tests/k6/benchmark.sh",
    "perf:k6:run": "sh tests/k6/run.sh",
    "perf:k6:limit": "sh tests/k6/find-limit.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/seed.ts",
    "db:seed:demo": "bun run src/seed-demo.ts",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.7",
    "@grpc/proto-loader": "0.8.1",
    "@nestjs/authentication": "0.1.6",
    "@nestjs/bullmq": "12.0.2",
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/cqrs": "^12.1.3",
    "@nestjs/drizzle": "^0.0.2",
    "@nestjs/http-client": "0.0.3",
    "@nestjs/locks": "0.0.6",
    "@nestjs/microservices": "12.5.0",
    "@nestjs/platform-node": "^12.5.0",
    "@nestjs/schedule": "12.0.4",
    "@nestjs/terminus": "12.2.0",
    "@nestjs/throttler": "6.8.0",
    "bullmq": "6.7.6",
    "drizzle-orm": "^1.0.0-rc.5",
    "ioredis": "6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^1.0.0-rc.5",
    "openai": "7.57.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "simple-git-hooks": "2.14.0",
    "supertest": "^7.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "[ ! -f scripts/pre-commit.ts ] || bun scripts/pre-commit.ts"
  }
}
