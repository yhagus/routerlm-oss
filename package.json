{
  "name": "routerlm-nest",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "oxfmt src test scripts",
    "format:check": "oxfmt --check src test scripts",
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:debug": "bun --inspect --watch src/main.ts",
    "start:prod": "node dist/main.js",
    "worker": "bun run src/worker.ts",
    "worker:dev": "bun --watch src/worker.ts",
    "worker:prod": "node dist/worker.js",
    "lint": "oxlint --type-aware src/ test/ scripts/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:e2e:docker": "bun scripts/test-e2e-docker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/seed.ts",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "[ ! -f scripts/pre-commit.ts ] || bun scripts/pre-commit.ts"
  },
  "dependencies": {
    "@nestjs/authentication": "0.1.6",
    "@nestjs/bullmq": "12.0.2",
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/cqrs": "^12.1.3",
    "@nestjs/drizzle": "^0.0.2",
    "@nestjs/http-client": "0.0.3",
    "@nestjs/platform-node": "^12.5.0",
    "bullmq": "6.7.6",
    "drizzle-orm": "^1.0.0-rc.5",
    "ioredis": "6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^1.0.0-rc.5",
    "openai": "7.57.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "simple-git-hooks": "2.14.0",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
