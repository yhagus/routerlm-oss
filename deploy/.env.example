# Settings for compose.yaml. Save as `.env` next to it.

# --- Required -------------------------------------------------------------
# Encrypts Provider Account keys at rest (AES-256-GCM): 32 random bytes in
# base64. Generate with `openssl rand -base64 32`. Keep it safe: losing or
# changing it makes stored Provider Account keys unreadable.
ENCRYPTION_KEY=
# Postgres password. Only applied when the database volume is first created;
# afterwards it must match the password the volume was created with. An
# install moved from a clone of the repo used `routerlm` unless it set one.
POSTGRES_PASSWORD=

# --- Optional, with defaults ----------------------------------------------
# The image version to run. Unset, it is the version of the release this
# compose.yaml came from. Upgrade by raising it, then
# `docker compose pull && docker compose up -d`.
# ROUTERLM_VERSION=2.1.0
# Origin the browser opens the dashboard on; the backend trusts its session
# requests. Set it to your public URL behind a reverse proxy.
# WEB_ORIGIN=http://localhost:3001
# Provider URLs must be https and not localhost, private or link-local.
# Set true to lift both rules, for example for Ollama or vLLM on your LAN.
# ALLOW_PRIVATE_UPSTREAMS=true
# The gateway's base URL as clients reach it, shown in the /docs examples.
# Unset, the docs use the browser's host on port 3000.
# NUXT_PUBLIC_GATEWAY_URL=https://gateway.example.com
# Host ports. TLS and a reverse proxy in front of them are up to you.
# BACKEND_PORT=3000
# WEB_PORT=3001
# Postgres user and database (only applied when the db volume is first created).
# POSTGRES_USER=routerlm
# POSTGRES_DB=routerlm
# For an install moved from a clone in a folder not named routerlm-oss: that
# folder's name, so the stack finds its existing volumes.
# COMPOSE_PROJECT_NAME=routerlm-oss
