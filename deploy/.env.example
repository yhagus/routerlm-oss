# Settings for compose.yaml. Save as `.env` next to it.

# --- Required -------------------------------------------------------------
# Encrypts Provider Account keys at rest (AES-256-GCM): 32 random bytes in
# base64. Generate with `openssl rand -base64 32`. Keep it safe: losing or
# changing it makes stored Provider Account keys unreadable.
ENCRYPTION_KEY=
# Postgres password. Only applied when the database volume is first created;
# afterwards it must match the password the volume was created with. An
# install moved from a clone of the repo used `routerlm` unless it set one.
POSTGRES_PASSWORD=

# --- Optional, with defaults ----------------------------------------------
# The image version to run. Unset, it is the version of the release this
# compose.yaml came from. Upgrade by raising it, then
# `docker compose pull && docker compose up -d --remove-orphans`.
# ROUTERLM_VERSION=2.1.0
# What Caddy, the edge proxy, serves the gateway's API and the dashboard on
# (ADR 0094). Unset, plain HTTP on ports 3000 and 3001. For production, set
# both to hostnames whose DNS points at this machine, and keep ports 80 and
# 443 open: Caddy serves them over HTTPS and gets their certificates itself.
# Then set WEB_ORIGIN and NUXT_PUBLIC_GATEWAY_URL to match.
# ROUTERLM_API_ADDRESS=api.example.com
# ROUTERLM_DASHBOARD_ADDRESS=dashboard.example.com
# Origin the browser opens the dashboard on; the backend trusts its session
# requests.
# WEB_ORIGIN=https://dashboard.example.com
# The gateway's base URL as clients reach it, shown in the /docs examples.
# Unset, the docs use the browser's host on port 3000.
# NUXT_PUBLIC_GATEWAY_URL=https://api.example.com
# How often each backend instance reloads its snapshot from the database, in
# ms. Bounds how long a revoked API Key or disabled Provider keeps working.
# SNAPSHOT_RELOAD_INTERVAL_MS=30000
# Gateway processes in the inference and admin containers. Each uses up to
# one CPU, so give inference the VM's CPUs. Linux only (ADR 0025).
# INFERENCE_PROCESSES=1
# ADMIN_PROCESSES=1
# The compose network's subnet. Only Caddy reaches the backend containers, so
# it is also the only X-Forwarded-For source they trust. Change it if it
# collides with another network.
# ROUTERLM_SUBNET=172.29.84.0/24
# The worker's port for the control plane over gRPC (plaintext h2c), for
# Integrations. Unset, no gRPC server starts. compose.yaml publishes no port
# for it: keep it on a private network or behind a TLS proxy, never on the
# internet. Bun's HTTP/2 server ignores some flood and reset protections.
# CONTROL_PLANE_PORT=50051
# Host ports Caddy publishes: the API and dashboard over plain HTTP, and
# HTTP/HTTPS for hostname addresses.
# BACKEND_PORT=3000
# WEB_PORT=3001
# HTTP_PORT=80
# HTTPS_PORT=443

# Postgres user and database (only applied when the db volume is first created).
# POSTGRES_USER=routerlm
# POSTGRES_DB=routerlm
# For an install moved from a clone in a folder not named routerlm-oss: that
# folder's name, so the stack finds its existing volumes.
# COMPOSE_PROJECT_NAME=routerlm-oss
